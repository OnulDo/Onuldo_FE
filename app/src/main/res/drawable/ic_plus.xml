        android:pathData="M12,4 L12,20"
        android:strokeColor="#FC6B2B"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M4,12 L20,12"
        android:strokeColor="#FC6B2B"
